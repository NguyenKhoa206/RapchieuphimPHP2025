Options -Indexes
DirectoryIndex index.php

# Use public/ as DocumentRoot whenever possible. These rules also protect XAMPP subfolders.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?:app|config|database|scripts|storage|tests|docs)(?:/|$) - [F,L]
    RewriteRule (^|/)\. - [F,L]
    RewriteRule ^(?:README\.md|composer\.(?:json|lock)|package(?:-lock)?\.json)$ - [F,L]
</IfModule>
